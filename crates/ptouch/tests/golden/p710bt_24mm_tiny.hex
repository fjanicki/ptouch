# Golden job stream `p710bt_24mm_tiny` (format: tests/golden/README.md).
# model = PtP710bt, tape = "tze128-24", pages = 1, lines = [5]
# options = JobOptions { cut: EveryLabel, mirror: false, chain: false, special_tape: false, high_resolution: false, feed_margin_dots: None, compression: None, auto_status: true, z_for_blank_lines: true, pad_short_pages: true }
# Raster lines in send order = LastColumnFirst (PROTOCOL.md §5.3; [HW] PT-P710BT).
# Generated by `UPDATE_GOLDEN=1 cargo test -p ptouch --test encode`; review every change.

# -- preamble --
00*100                                           # invalidate ×100
1B 40                                            # ESC @ initialize

# -- page 1 --
1B 69 61 01                                      # ESC i a command mode 01
1B 69 21 00                                      # ESC i ! status notification 00
1B 69 7A 84 00 18 00 05 00 00 00 00 00           # ESC i z n1=84 n2=00 width=24 length=0 lines=5 n9=0
1B 69 4D 40                                      # ESC i M various mode 40
1B 69 4B 08                                      # ESC i K advanced mode 08
1B 69 64 0E 00                                   # ESC i d margin 14
4D 02                                            # M compression 02
47 04 00 F2 00 00 FF                             # G raster line (4 bytes)
47 04 00 00 80 F2 00                             # G raster line (4 bytes)
47 04 00 F2 00 00 01                             # G raster line (4 bytes)
5A                                               # Z blank line
47 02 00 F1 FF                                   # G raster line (2 bytes)
1A                                               # ^Z print and feed
